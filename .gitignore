# Gradle files
.gradle/
.kotlin/
build/
**/build/
!src/**/build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# Xcode project files and folders
xcuserdata
.DS_Store
.externalNativeBuild
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# subagent worktrees live inside the repo
.worktrees/

# repo-local caches: emsdk, the CPython wasm build and its staged runtime (tools/wasm/build-cpython.sh)
.caches/

# scratch space for agents and scripts; delete when done
.tmp/

# TypedPython benchmark harness: uv venv, Cython/numba build output and numba caches
benchmarks/typedpython/.venv/
benchmarks/typedpython/build/
benchmarks/typedpython/target/
benchmarks/typedpython/java-out/
benchmarks/typedpython/tp-build/
