/*
 * Reached from PythonTestFixture.mainGlobals, and before these were registered the second
 * object-model test on Android died with SIGSEGV at fault address 0xc24110e8 -- a truncated
 * pointer, the signature of the name-linked @CName fallback described in ROADMAP §2.
 *
 * PyImport_AddModule returns a BORROWED reference where PyImport_AddModuleRef returns a new one.
 * The two are not interchangeable at the call site and the Kotlin actual keeps that distinction.
 */
static jlong f_PyImport_AddModuleN(JNIEnv *e, jclass c, jlong n) { return PyImport_AddModule((const char*)n); }
/*
 * Borrowed reference into the interpreter's sys module dict; the caller must not release it.
 *
 * Left on the name-linked @CName fallback it did not fail loudly -- it returned a null pointer,
 * which surfaced as an NPE in GilParkingTest rather than as a crash, so it read like a missing
 * "modules" entry instead of missing wiring. Ordinary JNI, not @FastNative: sys.__dict__ lookups
 * go through PyDict_GetItemWithError, which can run a __eq__ or __hash__.
 */
static jlong f_PySys_GetObjectN(JNIEnv *e, jclass c, jlong n) { return PySys_GetObject((const char*)n); }
