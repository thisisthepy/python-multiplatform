/* The out-parameter's slot is an ordinary C local, so the boundary still carries only
   primitives. Status 1 means the slot was written; 0 (dead referent) and -1 (error) both
   collapse to 0, which the caller separates with PyErr_Occurred. */
static jlong f_PyWeakref_GetRefN(JNIEnv *e, jclass c, jlong ref) {
    void *obj = NULL;
    if (PyWeakref_GetRef(ref, &obj) != 1) return 0;
    return (jlong)obj;
}
