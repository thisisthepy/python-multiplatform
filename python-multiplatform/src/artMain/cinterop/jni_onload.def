/*
 * ===========================================================================
 * Shape vocabulary.
 * ===========================================================================
 *
 * The 14 ABI shapes every CPython Stable ABI function collapses into (see
 * docs/design/downcall-design.md and jvmMain/.../ShapeDowncalls.kt). The target function's address
 * arrives as the leading `fn` argument and is called indirectly.
 *
 * These used to reach the `@CName` trampolines in `nativeMain/.../EmbedAPI.native.kt` by name,
 * which is the broken path -- and worse than the ordinary case, because a shape function's first
 * argument is a function pointer, so a shifted argument register is a wild call rather than a bad
 * PyObject*. Doing the indirect call here removes both the fallback and the extra hop through
 * Kotlin/Native.
 *
 * Ordinary JNI: `fn` can be any CPython entry point, including ones that run Python.
 */
static void f_downcall_V(JNIEnv *e, jclass c, jlong fn) { ((void (*)(void))(intptr_t)fn)(); }
static jlong f_downcall_I(JNIEnv *e, jclass c, jlong fn) { return ((jlong (*)(void))(intptr_t)fn)(); }
static jdouble f_downcall_F(JNIEnv *e, jclass c, jlong fn) { return ((jdouble (*)(void))(intptr_t)fn)(); }
static void f_downcallI_V(JNIEnv *e, jclass c, jlong fn, jlong a0) { ((void (*)(jlong))(intptr_t)fn)(a0); }
static jlong f_downcallI_I(JNIEnv *e, jclass c, jlong fn, jlong a0) { return ((jlong (*)(jlong))(intptr_t)fn)(a0); }
static jdouble f_downcallI_F(JNIEnv *e, jclass c, jlong fn, jlong a0) { return ((jdouble (*)(jlong))(intptr_t)fn)(a0); }
static jlong f_downcallF_I(JNIEnv *e, jclass c, jlong fn, jdouble a0) { return ((jlong (*)(jdouble))(intptr_t)fn)(a0); }
static void f_downcallII_V(JNIEnv *e, jclass c, jlong fn, jlong a0, jlong a1) { ((void (*)(jlong, jlong))(intptr_t)fn)(a0, a1); }
static jlong f_downcallII_I(JNIEnv *e, jclass c, jlong fn, jlong a0, jlong a1) { return ((jlong (*)(jlong, jlong))(intptr_t)fn)(a0, a1); }
static void f_downcallIII_V(JNIEnv *e, jclass c, jlong fn, jlong a0, jlong a1, jlong a2) { ((void (*)(jlong, jlong, jlong))(intptr_t)fn)(a0, a1, a2); }
static jlong f_downcallIII_I(JNIEnv *e, jclass c, jlong fn, jlong a0, jlong a1, jlong a2) { return ((jlong (*)(jlong, jlong, jlong))(intptr_t)fn)(a0, a1, a2); }
static jlong f_downcallIIII_I(JNIEnv *e, jclass c, jlong fn, jlong a0, jlong a1, jlong a2, jlong a3) { return ((jlong (*)(jlong, jlong, jlong, jlong))(intptr_t)fn)(a0, a1, a2, a3); }
static jlong f_downcallIIIII_I(JNIEnv *e, jclass c, jlong fn, jlong a0, jlong a1, jlong a2, jlong a3, jlong a4) { return ((jlong (*)(jlong, jlong, jlong, jlong, jlong))(intptr_t)fn)(a0, a1, a2, a3, a4); }
static jlong f_downcallIIIIII_I(JNIEnv *e, jclass c, jlong fn, jlong a0, jlong a1, jlong a2, jlong a3, jlong a4, jlong a5) { return ((jlong (*)(jlong, jlong, jlong, jlong, jlong, jlong))(intptr_t)fn)(a0, a1, a2, a3, a4, a5); }

/*
 * Symbol lookup for the shapes above.
 *
 * `dlopen(NULL, RTLD_NOW)` returns a handle onto the process's global symbol table without
 * loading anything -- libpython is already there, linked at build time. This mirrors what
 * `ffiSymbolRaw` did in `nativeMain`, minus the jstring: the name arrives as an already-encoded
 * C string address, because `ffiSymbol` on the JVM side caches by name and so encodes each
 * symbol once.
 */
static void *g_dlGlobal = NULL;
static jlong f_ffiSymbolRawN(JNIEnv *e, jclass c, jlong name) {
    if (name == 0) return 0;
    if (g_dlGlobal == NULL) g_dlGlobal = dlopen(NULL, RTLD_NOW);
    if (g_dlGlobal == NULL) return 0;
    return (jlong)(intptr_t)dlsym(g_dlGlobal, (const char *)(intptr_t)name);
}


/*
 * Composition probes.
 *
 * Everything else here crosses the JNI boundary once per C API call. These do the whole
 * binder-level operation on the native side and cross once, which is the design the Android
 * path was originally built around (artMain assembling, androidMain calling the assembly).
 * They exist to measure what that structure is worth before committing to it.
 *
 * Ordinary JNI on purpose: they need JNIEnv to touch the jstring and the jlong[], and they
 * run Python code, so a GC-blocking convention would be wrong regardless of speed.
 */
static jlong asm_getattr(JNIEnv *e, jclass c, jlong obj, jstring name) {
    const char *n = (*e)->GetStringUTFChars(e, name, NULL);
    if (n == NULL) return 0;
    jlong r = PyObject_GetAttrString(obj, n);
    (*e)->ReleaseStringUTFChars(e, name, n);
    if (r == 0) PyErr_Clear();
    return r;
}

static jint asm_list_to_array(JNIEnv *e, jclass c, jlong list, jlongArray out) {
    jsize cap = (*e)->GetArrayLength(e, out);
    jlong len = PyList_Size(list);
    jsize n = (len < (jlong)cap) ? (jsize)len : cap;
    jlong *buf = (*e)->GetLongArrayElements(e, out, NULL);
    if (buf == NULL) return -1;
    for (jsize i = 0; i < n; i++) buf[i] = PyList_GetItem(list, (jlong)i);
    (*e)->ReleaseLongArrayElements(e, out, buf, 0);
    return n;
}

/*
 * Python3.exec composed into one crossing.
 *
 * The Kotlin version crosses roughly eleven times: three C strings each needing an alloc and a
 * free around the call that uses them, plus AddModuleRef, GetAttrString, RunString and the
 * DecRefs. This is the same sequence with the boundary crossed once, so the difference between
 * them is everything the boundary costs -- crossings and string marshalling both.
 *
 * Unlike the echo probes this runs real Python, so the parse/compile/execute work is in both
 * numbers and the ratio shows what fraction of a realistic binder call the boundary actually is.
 */
/*
 * No NUM_METHODS constant lives here on purpose. There used to be one, it drifted out of step
 * with the table, and RegisterNatives silently bound a prefix of it. The count is taken with
 * sizeof at the call site instead, which cannot drift.
 */
#define PMP_FILE_INPUT 257

static jint asm_exec(JNIEnv *e, jclass c, jstring code) {
    const char *src = (*e)->GetStringUTFChars(e, code, NULL);
    if (src == NULL) return -1;
    jint rc = -1;
    jlong mod = PyImport_AddModuleRef("__main__");
    if (mod != 0) {
        jlong globals = PyObject_GetAttrString(mod, "__dict__");
        if (globals != 0) {
            jlong result = PyRun_String(src, PMP_FILE_INPUT, globals, globals);
            if (result != 0) { Py_DecRef(result); rc = 0; } else { PyErr_Clear(); }
            Py_DecRef(globals);
        }
        Py_DecRef(mod);
    }
    (*e)->ReleaseStringUTFChars(e, code, src);
    return rc;
}

/*
 * Address of a DirectByteBuffer's off-heap storage.
 *
 * Called once per scratch buffer, not per string. The point is that everything after it --
 * encoding the string and copying the bytes in -- happens inside the JVM with no crossing at
 * all, which is what Panama does on desktop and what makes desktop's marshalling ~12x cheaper
 * than ffiAllocUtf8's JNI round trip.
 */
static jlong ffi_direct_addr(JNIEnv *e, jclass c, jobject buf) {
    return (jlong)(*e)->GetDirectBufferAddress(e, buf);
}

#include <pthread.h>

static JavaVM *g_vm = NULL;
static jclass g_upcallClass = NULL;
static jmethodID g_upcallPrimitive = NULL;
static jmethodID g_upcallString = NULL;
static jmethodID g_upcallTrack = NULL;

static jlong test_upcall_primitive(JNIEnv *env, jclass clazz, jlong x) {
    return (*env)->CallStaticLongMethod(env, g_upcallClass, g_upcallPrimitive, x);
}

static jlong test_upcall_string(JNIEnv *env, jclass clazz, jstring s) {
    const char *cstr = (*env)->GetStringUTFChars(env, s, NULL);
    if (!cstr) return 0;
    jstring jstr = (*env)->NewStringUTF(env, cstr);
    jlong res = (*env)->CallStaticLongMethod(env, g_upcallClass, g_upcallString, jstr);
    (*env)->DeleteLocalRef(env, jstr);
    (*env)->ReleaseStringUTFChars(env, s, cstr);
    return res;
}

struct UnattachedData { jlong x; jlong res; };

static void* unattached_thread_func(void* arg) {
    struct UnattachedData* d = (struct UnattachedData*)arg;
    JNIEnv *env = NULL;
    if ((*g_vm)->AttachCurrentThread(g_vm, &env, NULL) == JNI_OK) {
        d->res = (*env)->CallStaticLongMethod(env, g_upcallClass, g_upcallPrimitive, d->x);
        (*g_vm)->DetachCurrentThread(g_vm);
    }
    return NULL;
}

static jlong test_upcall_unattached(JNIEnv *env, jclass clazz, jlong x) {
    struct UnattachedData d = {x, -1};
    pthread_t t;
    pthread_create(&t, NULL, unattached_thread_func, &d);
    pthread_join(t, NULL);
    return d.res;
}

/*
 * The experiment `pmp_attach`'s design rests on: a pthread that attaches as a daemon, calls into
 * the JVM, and exits without detaching.
 *
 * The claim being tested is the one this file used to assert as fact -- that ART aborts the
 * process for this. Reading `Thread::ThreadExitCallback` says it does not (see the block above
 * `pmp_attach`), but a reading is not an observation, and the whole per-thread attach depends on
 * which of the two is true. So it is run.
 *
 * The `java.lang.Thread` id of the attachment is handed back, because "did not abort" is only
 * half the answer: the other half is what the process is left holding, and the caller can ask the
 * thread list whether that peer is still in it.
 *
 * Deliberately does not register `g_detachKey` -- this is the *un*fixed path, kept as the
 * evidence for the fixed one.
 */
struct LeakedAttachData { jlong id; };

static void* leaked_attach_thread_func(void* arg) {
    struct LeakedAttachData* d = (struct LeakedAttachData*)arg;
    JNIEnv *env = NULL;
    if ((*g_vm)->AttachCurrentThreadAsDaemon(g_vm, &env, NULL) != JNI_OK) return NULL;

    if (g_upcallClass != NULL && g_upcallTrack != NULL) {
        d->id = (*env)->CallStaticLongMethod(env, g_upcallClass, g_upcallTrack);
    }
    if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
    /* No DetachCurrentThread, and that is the point. */
    return NULL;
}

static jlong test_attach_without_detach(JNIEnv *env, jclass clazz, jlong unused) {
    struct LeakedAttachData d = {-1};
    pthread_t t;
    if (g_vm == NULL) return -1;
    if (pthread_create(&t, NULL, leaked_attach_thread_func, &d) != 0) return -1;
    /* Returns only once the thread's TSD destructors have run, so ART's exit callback is past. */
    pthread_join(t, NULL);
    return d.id;
}

static void* empty_thread_func(void* arg) { return NULL; }

static jlong test_thread_create_floor(JNIEnv *env, jclass clazz, jlong x) {
    pthread_t t;
    pthread_create(&t, NULL, empty_thread_func, NULL);
    pthread_join(t, NULL);
    return x;
}

/*
 * ===========================================================================
 * Cycle-collecting proxy type.
 * ===========================================================================
 *
 * Desktop builds tp_traverse/tp_clear as Panama upcall stubs; Kotlin/Native builds them with
 * staticCFunction. Android has neither -- androidMain is Kotlin/JVM without Panama -- so the two
 * slots are plain C functions here, and they reach Kotlin the same way everything else on this
 * path does: through JNI, against a class registered in JNI_OnLoad.
 *
 * That inversion decides the division of labour. `visit` is a C function pointer that the JVM
 * side has no way to call, so C keeps the visiting: Kotlin is asked only "which raw PyObject
 * pointers does the object behind this handle hold?" and answers with a jlong[]. The loop over
 * that array, and every call to `visit`, happens on this side.
 *
 * CPython holds the GIL when it calls both slots. Nothing here takes it and nothing here may
 * release it.
 *
 * Layout note: the type is declared with a NEGATIVE basicsize, so the 8-byte handle lives in
 * relative type data reached through PyObject_GetTypeData. Nothing here reads inside PyObject,
 * which is what keeps the abi3 assumption the rest of the FFI layer makes.
 */

typedef int (*pmp_visitproc)(void *, void *);

/* Mirrors CPython's PyType_Slot / PyType_Spec. Declared rather than included: this .def has no
 * Python.h on its include path (only the `python` cinterop does), and both structs are part of
 * the stable ABI, so their layout is fixed. */
typedef struct { int slot; void *pfunc; } pmp_type_slot;
typedef struct {
    const char *name;
    int basicsize;
    int itemsize;
    unsigned int flags;
    pmp_type_slot *slots;
} pmp_type_spec;

extern jlong PyType_FromSpec(void *spec);
extern void *PyObject_GetTypeData(jlong obj, jlong type);

/*
 * The two the dealloc slot needs. PyObject_Type and Py_DecRef are already declared above.
 *
 * PyType_GetSlot is the abi3 route to a slot function of a type whose struct is opaque under the
 * limited API; tp_dealloc needs it for Py_tp_free (74), because a hand-written dealloc has to
 * free the object itself and only the type knows which allocator to use.
 */
extern void *PyType_GetSlot(jlong type, int slot);
extern void PyObject_GC_UnTrack(void *op);

/* CPython's freefunc: void (*)(void *). */
typedef void (*pmp_freefunc)(void *);

static jlong g_proxyType = 0;
static pmp_type_slot g_proxySlots[5];
static pmp_type_spec g_proxySpec;

static jclass g_proxyCallbacks = NULL;
static jmethodID g_proxyTraverse = NULL;
static jmethodID g_proxyClear = NULL;

/*
 * A JNIEnv for a thread CPython may or may not have entered from the JVM.
 *
 * On most paths the collector runs on the thread that called into Python, and that thread came
 * *from* ART -- so GetEnv succeeds and nothing is attached. The exception is a thread CPython
 * created itself (threading.Thread is a bare pthread), where a collection, or a refcount reaching
 * zero, runs on a thread ART has never seen. That is the case AttachCurrentThreadAsDaemon covers.
 *
 * That branch is exercised rather than assumed. CycleCollectionTest's
 * testCycleCollectedOnAThreadCPythonCreated and testDeallocOnAThreadCPythonCreated do their work
 * inside a threading.Thread, and they assert that the thread the callback arrived on is not the
 * instrumentation thread -- so a pass cannot come from GetEnv having succeeded after all. Green
 * on pmp_api26 and pmp_api36.
 *
 * ### The attachment is kept for the life of the thread, not the life of the call
 *
 * This used to detach on every exit, on the stated grounds that "ART aborts the process when a
 * thread it knows about exits without detaching". That is measurably expensive and, on Android,
 * it is not what ART does. `Thread::ThreadExitCallback` (runtime/thread.cc, unchanged in shape
 * from android-8.0.0_r1 to main) reads:
 *
 *     if (self->tls32_.thread_exit_check_count == 0) {
 *       LOG(WARNING) << "Native thread exiting without having called DetachCurrentThread (maybe "
 *           "it's going to use a pthread_key_create destructor?): " << *self;
 *       CHECK(is_started_);
 *     #ifdef __BIONIC__
 *       __get_tls()[TLS_SLOT_ART_THREAD_SELF] = self;
 *     #else
 *       CHECK_PTHREAD_CALL(pthread_setspecific, (Thread::pthread_key_self_, self), "reattach self");
 *     #endif
 *       self->tls32_.thread_exit_check_count = 1;
 *     } else {
 *       LOG(FATAL) << "Native thread exited without calling DetachCurrentThread: " << *self;
 *     }
 *
 * The LOG(FATAL) is reached only on a *second* invocation of the callback, and the only thing
 * that arms a second invocation is the `pthread_setspecific` in the `#else` -- which Android does
 * not take. Bionic clears a key's value before running its destructor and never re-reads it, so
 * on Android the callback fires exactly once and the abort is unreachable. What is left is a
 * warning, and a leak: the `java.lang.Thread` peer stays a GC root in the thread list with a
 * recorded stack the pthread has already unmapped.
 *
 * So the detach is still mandatory -- but it belongs at thread death, not at call exit, which is
 * the case the warning text itself points at. `pmp_thread_exit_detach` below is that destructor.
 * Threads that reach here from ART (GetEnv succeeds) are untouched: nothing was attached, so
 * nothing is registered and nothing is detached.
 *
 * `*attached` therefore now means "this call owns the attachment and must give it back", and it
 * is set only on the fallback path where no destructor could be registered. Callers keep their
 * `if (attached) DetachCurrentThread` exactly as before.
 */

/*
 * Set on a thread this file attached, so that thread's exit can detach it. The value is a
 * sentinel; the attachment itself lives in ART's own TLS.
 */
static pthread_key_t g_detachKey;
static int g_detachKeyReady = 0;

#define PMP_DETACH_PENDING ((void *)1)
#define PMP_DETACH_ARMED   ((void *)2)

/*
 * Detaches at thread death. Registered on g_detachKey, so bionic calls it while the pthread is
 * unwinding its thread-specific data.
 *
 * The first invocation re-arms instead of detaching, which is what makes this independent of the
 * order bionic happens to visit keys in. Bionic iterates keys by index, ascending, for up to
 * PTHREAD_DESTRUCTOR_ITERATIONS rounds, clearing each value before calling its destructor; ART's
 * own key is created during runtime startup and ours in JNI_OnLoad, so ours is almost certainly
 * the higher index and ART's callback would run first -- but "almost certainly" is not a
 * guarantee, and getting it wrong is not benign. Detaching first would free the ART `Thread`
 * while ART's key still holds a pointer to it, and ART's callback would then run `LOG(WARNING)
 * << *self` over freed memory. Deferring to the second round removes the question: ART's callback
 * can only run in a round where its value is still set, i.e. the first, and it does not re-arm
 * itself on Android, so by the time this detaches it has already been and gone.
 *
 * Detaching from here is safe for the same reason that ordering is: on Android `Thread::Current()`
 * comes from TLS_SLOT_ART_THREAD_SELF, a dedicated bionic slot that the pthread-key teardown does
 * not touch, and which ART's callback re-populates on its way past.
 *
 * A thread that was detached by other means before exiting still lands here with the sentinel
 * set; ART's DetachCurrentThread returns JNI_ERR for a thread it does not know, which is why that
 * case needs no separate guard.
 */
static void pmp_thread_exit_detach(void *value) {
    if (value == PMP_DETACH_PENDING &&
        g_detachKeyReady &&
        pthread_setspecific(g_detachKey, PMP_DETACH_ARMED) == 0) {
        return;
    }
    if (g_vm != NULL) (*g_vm)->DetachCurrentThread(g_vm);
}

static JNIEnv *pmp_attach(int *attached) {
    JNIEnv *env = NULL;
    *attached = 0;
    if (g_vm == NULL) return NULL;
    jint r = (*g_vm)->GetEnv(g_vm, (void **)&env, JNI_VERSION_1_6);
    if (r == JNI_OK) return env;
    if (r != JNI_EDETACHED) return NULL;
    if ((*g_vm)->AttachCurrentThreadAsDaemon(g_vm, &env, NULL) != JNI_OK) return NULL;
    /* Kept until the thread dies, unless there is no destructor to release it with. */
    if (g_detachKeyReady && pthread_setspecific(g_detachKey, PMP_DETACH_PENDING) == 0) return env;
    *attached = 1;
    return env;
}

/* The 8 bytes of relative type data on a proxy instance, or NULL if this is not one. */
static jlong *pmp_handle_slot(jlong obj) {
    if (g_proxyType == 0 || obj == 0) return NULL;
    return (jlong *)PyObject_GetTypeData(obj, g_proxyType);
}

/*
 * int tp_traverse(PyObject *self, visitproc visit, void *arg)
 *
 * The early returns are silent by design -- an object whose class is not registered with
 * ClassLookup simply has nothing to report. That silence is worth knowing about: it reads
 * exactly like "the object was never GC-tracked". If a cycle is not collected, check the
 * registration before suspecting the slots.
 *
 * A pending JVM exception is cleared rather than propagated. There is no error channel back
 * into a running collection except the return value, and a non-zero return aborts the traversal
 * instead of reporting anything.
 */
static int pmp_proxy_traverse(void *self, pmp_visitproc visit, void *arg) {
    if (visit == NULL) return 0;
    jlong *slot = pmp_handle_slot((jlong)self);
    if (slot == NULL) return 0;
    jlong handle = *slot;
    if (handle == 0) return 0;
    if (g_proxyCallbacks == NULL || g_proxyTraverse == NULL) return 0;

    int attached = 0;
    JNIEnv *env = pmp_attach(&attached);
    if (env == NULL) return 0;

    int rc = 0;
    jlongArray targets =
        (jlongArray)(*env)->CallStaticObjectMethod(env, g_proxyCallbacks, g_proxyTraverse, handle);
    if ((*env)->ExceptionCheck(env)) {
        (*env)->ExceptionClear(env);
        targets = NULL;
    }
    if (targets != NULL) {
        jsize n = (*env)->GetArrayLength(env, targets);
        if (n > 0) {
            jlong *buf = (*env)->GetLongArrayElements(env, targets, NULL);
            if (buf != NULL) {
                for (jsize i = 0; i < n; i++) {
                    if (buf[i] == 0) continue;
                    int r = visit((void *)buf[i], arg);
                    if (r != 0) { rc = r; break; }
                }
                (*env)->ReleaseLongArrayElements(env, targets, buf, JNI_ABORT);
            }
        }
        (*env)->DeleteLocalRef(env, targets);
    }
    if (attached) (*g_vm)->DetachCurrentThread(g_vm);
    return rc;
}

/*
 * Empties the object's handle slot and returns what was in it, or 0.
 *
 * Zeroing before the caller releases is what lets tp_clear and tp_dealloc run one after the
 * other without double-releasing. An object that dies inside a cycle takes both paths: tp_clear
 * breaks the loop, the refcount then falls to zero, and tp_dealloc follows. The second call
 * finds 0 here and does nothing.
 */
static jlong pmp_take_handle(void *self) {
    jlong *slot = pmp_handle_slot((jlong)self);
    if (slot == NULL) return 0;
    jlong handle = *slot;
    if (handle == 0) return 0;
    *slot = 0;
    return handle;
}

/*
 * Drops the Kotlin-side root for `handle`, and nothing else.
 *
 * Calling PyObject.close() on the Kotlin object's fields from here would decrement references
 * the collector is in the middle of accounting for, which double-frees. The collector reclaims
 * the Python side on its own.
 */
static void pmp_release_handle(jlong handle) {
    if (handle == 0) return;
    if (g_proxyCallbacks == NULL || g_proxyClear == NULL) return;

    int attached = 0;
    JNIEnv *env = pmp_attach(&attached);
    if (env == NULL) return;

    (*env)->CallStaticVoidMethod(env, g_proxyCallbacks, g_proxyClear, handle);
    if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);
    if (attached) (*g_vm)->DetachCurrentThread(g_vm);
}

/*
 * int tp_clear(PyObject *self)
 *
 * Releases the HandleTable entry and nothing else. That entry is the Kotlin-side half of the
 * cycle and dropping it is what breaks the loop.
 */
static int pmp_proxy_clear(void *self) {
    pmp_release_handle(pmp_take_handle(self));
    return 0;
}

/*
 * void tp_dealloc(PyObject *self) -- the slot tp_clear is not a substitute for.
 *
 * tp_clear runs only when the cyclic collector decides to break a loop. A proxy whose refcount
 * simply reaches zero never goes near it, and that is the ordinary case: cycles are the
 * exception. Without this slot every such proxy left its HandleTable entry rooted for the life of
 * the interpreter, holding a Kotlin object nothing could reach again.
 *
 * Unlike tp_clear, this one owns the object's memory. Installing it replaces CPython's
 * subtype_dealloc outright, so everything that function does for a GC'd heap type happens here:
 *
 *  - untrack first. The type carries Py_TPFLAGS_HAVE_GC, so the instance is on the collector's
 *    list; freeing it while still linked leaves the collector walking released memory.
 *  - free through the type's own tp_free, reached with PyType_GetSlot. The type must come from
 *    the instance rather than from g_proxyType: the type is declared Py_TPFLAGS_BASETYPE, so
 *    Python code may subclass it and inherit this function.
 *  - release the instance's reference to its type. Since 3.8 an instance of a heap type holds
 *    one and subtype_dealloc gives it back. Forgetting leaks the type once per instance; doing it
 *    twice frees the type while it is still in use.
 *
 * Py_TYPE is a macro over a struct this file deliberately does not include, so the type comes
 * from PyObject_Type -- a real stable-ABI function that returns a NEW reference. Hence the two
 * decrements: one for that temporary, one for the instance's own.
 *
 * CPython holds the GIL here, as for the other two slots. Nothing here takes or releases it.
 */
static void pmp_proxy_dealloc(void *self) {
    if (self == NULL) return;

    /* Taken before anything is torn down; this reference keeps the type alive across the free. */
    jlong type = PyObject_Type((jlong)self);

    PyObject_GC_UnTrack(self);
    pmp_release_handle(pmp_take_handle(self));

    if (type != 0) {
        pmp_freefunc tp_free = (pmp_freefunc)PyType_GetSlot(type, 74 /* Py_tp_free */);
        if (tp_free != NULL) {
            tp_free(self);
            Py_DecRef(type); /* the reference the instance held on its heap type */
        }
        Py_DecRef(type); /* the reference PyObject_Type just handed us */
    }
}

/*
 * Equivalent to PyMemberDef from structmember.h.
 * 40 bytes on 64-bit platforms (arm64-v8a, x86_64).
 */
typedef struct {
    const char *name;
    int type;
    intptr_t offset;
    int flags;
    const char *doc;
} pmp_member_def;

/*
 * Slot 3: Py_tp_members (72) -- the handle slot exposed as _pm_handle to Python.
 * Py_T_LONG = 2, Py_RELATIVE_OFFSET = 8.
 */
static pmp_member_def g_proxyMembers[2] = {
    {"_pm_handle", 2 /* Py_T_LONG */, 0 /* relative offset */, 8 /* Py_RELATIVE_OFFSET */, NULL},
    {NULL, 0, 0, 0, NULL}
};

/*
 * Creates the proxy type once and returns its address.
 *
 * The spec, its slot array and the name are statics rather than heap allocations, because
 * PyType_FromSpec stores spec->name directly as tp_name instead of copying it -- a freed name
 * would leave the type pointing at released memory. The type lives for the process anyway.
 *
 * Ordinary JNI: it runs type creation, which can execute arbitrary Python.
 */
static jlong proxy_create_type(JNIEnv *e, jclass c) {
    if (g_proxyType != 0) return g_proxyType;

    /* Slot ids from CPython's typeslots.h; they are ABI, not header-version-dependent. */
    g_proxySlots[0].slot = 71; /* Py_tp_traverse */
    g_proxySlots[0].pfunc = (void *)&pmp_proxy_traverse;
    g_proxySlots[1].slot = 51; /* Py_tp_clear */
    g_proxySlots[1].pfunc = (void *)&pmp_proxy_clear;
    g_proxySlots[2].slot = 52; /* Py_tp_dealloc */
    g_proxySlots[2].pfunc = (void *)&pmp_proxy_dealloc;
    g_proxySlots[3].slot = 72; /* Py_tp_members */
    g_proxySlots[3].pfunc = (void *)g_proxyMembers;
    g_proxySlots[4].slot = 0;  /* sentinel */
    g_proxySlots[4].pfunc = NULL;

    g_proxySpec.name = "KotlinProxy";
    g_proxySpec.basicsize = -8; /* 8 bytes of relative type data: the handle */
    g_proxySpec.itemsize = 0;
    /* Py_TPFLAGS_BASETYPE | Py_TPFLAGS_HAVE_GC */
    g_proxySpec.flags = (1u << 10) | (1u << 14);
    g_proxySpec.slots = g_proxySlots;

    g_proxyType = PyType_FromSpec(&g_proxySpec);
    return g_proxyType;
}

/*
 * Handle accessors, composed on this side.
 *
 * androidMain could not do this itself: writing 8 bytes at a raw address from Kotlin/JVM needs
 * sun.misc.Unsafe, which is a restricted non-SDK interface on Android. Crossing once with both
 * the object and the value is also cheaper than exposing PyObject_GetTypeData and poking at the
 * result, which is what artMain/README.md means by composed functions.
 */
static jlong proxy_get_handle(JNIEnv *e, jclass c, jlong obj) {
    jlong *slot = pmp_handle_slot(obj);
    return slot == NULL ? 0 : *slot;
}

static void proxy_set_handle(JNIEnv *e, jclass c, jlong obj, jlong handle) {
    jlong *slot = pmp_handle_slot(obj);
    if (slot != NULL) *slot = handle;
}

/*
 * ob_refcnt of the object at `obj`, read straight out of the header.
 *
 * Py_REFCNT is a macro over a struct this file does not include, and sys.getrefcount counts its
 * own argument's temporary reference -- neither can answer whether tp_dealloc released the
 * instance's reference to its heap type exactly once, which is what the cycle-collection tests
 * check. ob_refcnt is the first field of PyObject and the stable ABI fixes that; it is 64-bit on
 * both ABIs this project ships (arm64-v8a, x86_64), so jlong is the right width.
 *
 * A test probe. Composed here for the same reason proxy_set_handle is: reading 8 bytes at a raw
 * address from Kotlin/JVM needs sun.misc.Unsafe, a restricted non-SDK interface on Android.
 *
 * Ordinary JNI. A load of one word cannot run Python, but it is only ever called from a test, so
 * there is nothing to gain from a GC-blocking convention here.
 */
static jlong ob_refcnt(JNIEnv *e, jclass c, jlong obj) {
    if (obj == 0) return 0;
    return *(jlong *)(intptr_t)obj;
}

/*
 * ===========================================================================
 * Upcalls: Python -> Kotlin/JVM.
 * ===========================================================================
 *
 * The last of the three JVM/native inversions in this file, and the same one as the proxy type's:
 * desktop hands Python a Panama upcall stub, Kotlin/Native hands it a `staticCFunction`, and
 * Android can produce neither -- `androidMain` is Kotlin/JVM on ART. A `PyMethodDef`'s `ml_meth`
 * has to be a C function pointer, so the entry points are here and *they* call Kotlin, through
 * `python/native/ffi/UpcallCallbacks` registered in JNI_OnLoad.
 *
 * Only the address-publishing step lives here. Every argument and every result is marshalled by
 * `commonMain`'s UpcallTrampoline, which is shared with the other two platforms; what crosses this
 * boundary is `(jlong callableHandle, jlong argsTuple) -> jlong`, i.e. primitives only, which is
 * what androidMain/README.md requires of anything on this path.
 *
 * ### Conventions this side must not break
 *
 *  - `args` is **borrowed** and is passed straight through. Nothing here touches its refcount;
 *    the trampoline wraps its items with `borrowed = true`.
 *  - The result is a **new** reference, produced by the trampoline and returned unchanged.
 *  - `self` on a bound `pm_invoke` is the callable handle as a PyLong, borrowed like any
 *    PyCFunction's self. A bad one becomes -1 (CallableHandle.NONE), which the trampoline rejects
 *    with the error indicator set -- not a crash, and not a call to whatever entry 0 happens to be.
 *  - Failure leaves as 0 with Python's error indicator set. A pending *JVM* exception is cleared
 *    before returning, because ART aborts if one is left set across a return into native code.
 *
 * ### The GIL
 *
 * CPython holds the GIL when it calls a PyCFunction, so nothing here takes it. The trampoline on
 * the Kotlin side still takes its own PyGILState_Ensure/Release pair unconditionally -- that is
 * commonMain/README.md's rule for any entry point reached from C, and PyGILState_Ensure is
 * reentrant, so the second one costs a counter bump.
 *
 * ### Cost
 *
 * One JNI upcall per call, plus an attach the first time Python calls from a thread ART has never
 * seen -- every `threading.Thread` is a bare pthread, so that is not a corner case.
 *
 * The attach used to be paid on every call, because this file asserted that ART aborts a process
 * whose thread exits without detaching. It does not (see the block above pmp_attach, and
 * UpcallThreadAttachTest, which runs the case). Measured by UpcallOverheadTest on pmp_api26 /
 * pmp_api36, two runs each, per upcall from a Python worker in steady state:
 *
 *              was (attach per call)    now (attach per thread)
 *   API 26        59712-63293 ns             1209-1329 ns
 *   API 36        19820-31219 ns             2301-3086 ns
 *
 * against 1280-1327 ns / 2982-5086 ns for the same upcall on a thread ART already knows -- i.e.
 * the difference now straddles zero and the attach has stopped being visible in the steady state
 * at all. What is left is the JNI upcall itself, and the first call on each worker, which still
 * pays the whole attach: 56-142 us.
 */

/* From methodobject.h. Flag values are ABI, not header-version-dependent. */
#define PMP_METH_VARARGS 0x0001
#define PMP_METH_O       0x0008

/*
 * PyCFunction, with the same jlong-for-PyObject* convention the rest of this file uses. Both ABIs
 * this project ships (arm64-v8a, x86_64) pass a pointer and an int64_t identically.
 */
typedef jlong (*pmp_pycfunction)(jlong, jlong);

/* Mirrors CPython's PyMethodDef; stable ABI, so its layout is fixed. */
typedef struct {
    const char *ml_name;
    pmp_pycfunction ml_meth;
    int ml_flags;
    const char *ml_doc;
} pmp_method_def;

extern jlong PyCMethod_New(void *ml, jlong self, jlong module, jlong cls);
extern void *PyExc_RuntimeError;

static jclass g_upcallBridge = NULL;
static jmethodID g_upcallInvokeM = NULL;
static jmethodID g_upcallResolveM = NULL;
static jmethodID g_upcallReleaseM = NULL;
static jmethodID g_upcallCancelM = NULL;

static jlong pmp_upcall_invoke_meth(jlong self, jlong args);
static jlong pmp_upcall_invoke_free_meth(jlong self, jlong args);
static jlong pmp_upcall_resolve_meth(jlong self, jlong name);
static jlong pmp_upcall_bind_meth(jlong self, jlong handle);
static jlong pmp_upcall_release_meth(jlong self, jlong handle);
static jlong pmp_upcall_cancel_meth(jlong self, jlong handle);

/*
 * Static rather than heap-allocated: a PyCFunction object stores the PyMethodDef * it was built
 * from instead of copying it, so anything freed here would leave every callable built from it
 * pointing at released memory. Six structs for the life of the process.
 */
static pmp_method_def g_pmInvokeDef =
    {"pm_invoke", &pmp_upcall_invoke_meth, PMP_METH_VARARGS, NULL};
static pmp_method_def g_pmInvokeFreeDef =
    {"_pm_invoke", &pmp_upcall_invoke_free_meth, PMP_METH_VARARGS, NULL};
static pmp_method_def g_pmResolveDef =
    {"_pm_resolve", &pmp_upcall_resolve_meth, PMP_METH_O, NULL};
static pmp_method_def g_pmBindDef =
    {"_pm_bind", &pmp_upcall_bind_meth, PMP_METH_O, NULL};
static pmp_method_def g_pmReleaseDef =
    {"_pm_release", &pmp_upcall_release_meth, PMP_METH_O, NULL};
static pmp_method_def g_pmCancelDef =
    {"_pm_cancel", &pmp_upcall_cancel_meth, PMP_METH_O, NULL};

/*
 * Returns 0 -- the only failure signal this boundary has -- with an error indicator set.
 *
 * An error Python already has is left exactly as it is. Overwriting it would replace whatever the
 * exposed Kotlin function raised with a generic message from the plumbing, and the trampoline sets
 * one on every failure it handles itself.
 */
static jlong pmp_upcall_fail(const char *msg) {
    if (PyErr_Occurred() == 0) {
        PyErr_SetString((jlong)(intptr_t)PyExc_RuntimeError, msg);
    }
    return 0;
}

/* The callable handle inside a bound pm_invoke's `self`, or -1 (CallableHandle.NONE). */
static jlong pmp_upcall_handle_of(jlong self) {
    jlong handle;
    if (self == 0) return -1;
    handle = PyLong_AsLongLong(self);
    if (PyErr_Occurred() != 0) {
        PyErr_Clear();
        return -1;
    }
    return handle;
}

/*
 * PyObject *pm_invoke(PyObject *self, PyObject *args) -- the one C shape argument passing needs.
 *
 * `self` carries the callable handle; when the generated proxy type lands it carries the receiver
 * instead and this signature does not change, which is the whole reason the shape was chosen.
 */
static jlong pmp_upcall_invoke_meth(jlong self, jlong args) {
    JNIEnv *env;
    int attached = 0;
    jlong result;

    if (g_upcallBridge == NULL || g_upcallInvokeM == NULL) {
        return pmp_upcall_fail("the Kotlin upcall bridge was not registered at load time");
    }
    env = pmp_attach(&attached);
    if (env == NULL) return pmp_upcall_fail("no JNIEnv is available on this thread");

    result = (*env)->CallStaticLongMethod(
        env, g_upcallBridge, g_upcallInvokeM, pmp_upcall_handle_of(self), args);
    if ((*env)->ExceptionCheck(env)) {
        (*env)->ExceptionClear(env);
        result = 0;
    }
    if (attached) (*g_vm)->DetachCurrentThread(g_vm);

    if (result == 0) return pmp_upcall_fail("the Kotlin upcall failed");
    return result;
}

/*
 * PyObject *_pm_invoke(PyObject *self, PyObject *args) -- METH_VARARGS, **unbound**: `args` is
 * `(handle, args_tuple)`.
 *
 * The shape PythonProxySource's generated module calls, and the same one desktop's
 * `ctypes.CFUNCTYPE(py_object, c_long, py_object)` shim and nativeMain's `pmInvokeFreeMethod`
 * present. It grants nothing pmp_upcall_bind_meth did not already grant -- `_pm_bind` takes a raw
 * handle straight from Python and hands back a callable over it, so `_pm_bind(h)(*a)` and
 * `_pm_invoke(h, a)` are the same capability with the same failure mode.
 *
 * Both tuple items are borrowed and nothing here releases either; the result is a new reference,
 * which is UpcallTrampoline's contract and the same one pmp_upcall_invoke_meth relies on.
 */
static jlong pmp_upcall_invoke_free_meth(jlong self, jlong args) {
    JNIEnv *env;
    int attached = 0;
    jlong handleItem;
    jlong callArgs;
    jlong raw;
    jlong result;

    if (g_upcallBridge == NULL || g_upcallInvokeM == NULL) {
        return pmp_upcall_fail("the Kotlin upcall bridge was not registered at load time");
    }
    /* METH_VARARGS guarantees a tuple, so this can only be the wrong arity. */
    if (args == 0 || PyTuple_Size(args) != 2) {
        return pmp_upcall_fail("_pm_invoke(handle, args_tuple) takes exactly two arguments");
    }
    handleItem = PyTuple_GetItem(args, 0);
    /* CallableHandle.NONE for a missing item; a non-integer leaves its own TypeError pending. */
    raw = (handleItem == 0) ? -1 : PyLong_AsLongLong(handleItem);
    if (PyErr_Occurred() != 0) return 0;
    /* Cannot fail for index 1 of a size-2 tuple. */
    callArgs = PyTuple_GetItem(args, 1);

    env = pmp_attach(&attached);
    if (env == NULL) return pmp_upcall_fail("no JNIEnv is available on this thread");

    result = (*env)->CallStaticLongMethod(env, g_upcallBridge, g_upcallInvokeM, raw, callArgs);
    if ((*env)->ExceptionCheck(env)) {
        (*env)->ExceptionClear(env);
        result = 0;
    }
    if (attached) (*g_vm)->DetachCurrentThread(g_vm);

    if (result == 0) return pmp_upcall_fail("the Kotlin upcall failed");
    return result;
}

/*
 * METH_O: `str` **or** `bytes` -> handle, or -1. Called once per name; every call after that
 * carries the integer.
 *
 * Both spellings are accepted because both are forced on real callers, exactly as nativeMain's
 * pmResolveMethod records. A PyMethodDef host writes `_pm_resolve('pkg.fn')`, which is what `str`
 * is for -- androidInstrumentedTest's bindUpcallOrNull does. But the one piece of Python that has
 * to work against every host, PythonProxySource's `_pm_lookup`, sends `bytes`: desktop reaches its
 * resolver through `ctypes.CFUNCTYPE(c_long, c_char_p)` and `c_char_p` refuses a `str` outright.
 *
 * This is the second half of the ART gap, and it was not the half that was written down. With only
 * `_pm_invoke` added, PythonProxyInstallTest got past the generated module's entry-point guard and
 * failed one line later on both emulators with `TypeError: bad argument type for built-in
 * operation` -- PyUnicode_AsUTF8 refusing the `bytes` `_pm_lookup` had just encoded.
 *
 * Costs one failed PyUnicode_AsUTF8 and a PyErr_Clear on the `bytes` path, at install time only.
 */
static jlong pmp_upcall_resolve_meth(jlong self, jlong name) {
    JNIEnv *env;
    int attached = 0;
    const char *text;
    jstring jname;
    jlong handle = -1;

    if (g_upcallBridge == NULL || g_upcallResolveM == NULL) {
        return pmp_upcall_fail("the Kotlin upcall bridge was not registered at load time");
    }
    text = (name == 0) ? NULL : PyUnicode_AsUTF8(name);
    if (text == NULL && name != 0) {
        /* The failed str read left a TypeError pending; it is not the answer yet. */
        PyErr_Clear();
        text = PyBytes_AsString(name);
    }
    /*
     * Neither spelling matched, so PyBytes_AsString's TypeError is left pending -- a better answer
     * than -1, which would read as "no such name". pmp_upcall_fail keeps whatever is already set.
     */
    if (text == NULL) return pmp_upcall_fail("_pm_resolve expects a str or bytes");

    env = pmp_attach(&attached);
    if (env == NULL) return pmp_upcall_fail("no JNIEnv is available on this thread");

    jname = (*env)->NewStringUTF(env, text);
    if (jname != NULL) {
        handle = (*env)->CallStaticLongMethod(env, g_upcallBridge, g_upcallResolveM, jname);
        if ((*env)->ExceptionCheck(env)) {
            (*env)->ExceptionClear(env);
            handle = -1;
        }
        (*env)->DeleteLocalRef(env, jname);
    } else if ((*env)->ExceptionCheck(env)) {
        (*env)->ExceptionClear(env);
    }
    if (attached) (*g_vm)->DetachCurrentThread(g_vm);

    return PyLong_FromLongLong(handle);
}

/*
 * METH_O: handle -> a callable that invokes it.
 *
 * The handle is deliberately not validated. A stale one is rejected by the trampoline at call time
 * with a proper Python exception, and checking twice would only move the same failure earlier while
 * adding a second place that has to agree with the table's epoch rule.
 *
 * PyCMethod_New takes its own reference to `self`, so the PyLong built here is given back
 * immediately -- keeping it would leak one integer per bound method.
 */
static jlong pmp_upcall_bind_meth(jlong self, jlong handle) {
    jlong raw;
    jlong boundSelf;
    jlong fn;

    raw = (handle == 0) ? -1 : PyLong_AsLongLong(handle);
    if (PyErr_Occurred() != 0) return 0;

    boundSelf = PyLong_FromLongLong(raw);
    if (boundSelf == 0) return 0;
    fn = PyCMethod_New(&g_pmInvokeDef, boundSelf, 0, 0);
    Py_DecRef(boundSelf);
    return fn;
}

/* METH_O: object handle -> 1 if it released a live entry. What a proxy's tp_dealloc calls. */
static jlong pmp_upcall_release_meth(jlong self, jlong handle) {
    JNIEnv *env;
    int attached = 0;
    jlong raw;
    jint released = 0;

    if (g_upcallBridge == NULL || g_upcallReleaseM == NULL) {
        return pmp_upcall_fail("the Kotlin upcall bridge was not registered at load time");
    }
    raw = (handle == 0) ? 0 : PyLong_AsLongLong(handle);
    if (PyErr_Occurred() != 0) return 0;

    env = pmp_attach(&attached);
    if (env == NULL) return pmp_upcall_fail("no JNIEnv is available on this thread");

    released = (*env)->CallStaticIntMethod(env, g_upcallBridge, g_upcallReleaseM, raw);
    if ((*env)->ExceptionCheck(env)) {
        (*env)->ExceptionClear(env);
        released = 0;
    }
    if (attached) (*g_vm)->DetachCurrentThread(g_vm);

    return PyLong_FromLongLong((jlong)released);
}

/*
 * METH_O: pending-call handle -> 1 if it cancelled a live call.
 *
 * What a cancelled asyncio.Future's done callback calls, so a suspended Kotlin coroutine hears
 * about the cancellation at its next ensureActive() rather than only when it finishes. Same shape
 * and same total-function rules as pmp_upcall_release_meth above.
 */
static jlong pmp_upcall_cancel_meth(jlong self, jlong handle) {
    JNIEnv *env;
    int attached = 0;
    jlong raw;
    jint cancelled = 0;

    if (g_upcallBridge == NULL || g_upcallCancelM == NULL) {
        return pmp_upcall_fail("the Kotlin upcall bridge was not registered at load time");
    }
    raw = (handle == 0) ? 0 : PyLong_AsLongLong(handle);
    if (PyErr_Occurred() != 0) return 0;

    env = pmp_attach(&attached);
    if (env == NULL) return pmp_upcall_fail("no JNIEnv is available on this thread");

    cancelled = (*env)->CallStaticIntMethod(env, g_upcallBridge, g_upcallCancelM, raw);
    if ((*env)->ExceptionCheck(env)) {
        (*env)->ExceptionClear(env);
        cancelled = 0;
    }
    if (attached) (*g_vm)->DetachCurrentThread(g_vm);

    return PyLong_FromLongLong((jlong)cancelled);
}

/* PyDict_SetItemString takes a reference of its own, so the one built here is given back. */
static int pmp_install_method(jlong ns, pmp_method_def *def) {
    int ok;
    jlong fn = PyCMethod_New(def, 0, 0, 0);
    if (fn == 0) return 0;
    ok = (PyDict_SetItemString(ns, def->ml_name, fn) == 0);
    Py_DecRef(fn);
    return ok;
}

/*
 * Installs `_pm_resolve`, `_pm_invoke`, `_pm_bind`, `_pm_release` and `_pm_cancel` into the Python
 * dict at `ns`. 1 on success.
 *
 * That set is the whole bootstrap: everything after it is Python calling Python objects.
 *
 * `_pm_invoke` used to be withheld here, on the argument that the handle should never reach Python
 * as a separate argument -- but `_pm_bind` hands Python the same handle and gives back a callable
 * over it, so the two are one capability, and the only consumer the bootstrap has (the module
 * PythonProxySource generates) calls `_pm_invoke(handle, args)` and refuses to install without it.
 * nativeMain's UpcallEntry.publish reversed the same decision for the same reason.
 *
 * Ordinary JNI. It builds function objects and stores them in a dict, so it allocates GC-tracked
 * containers and can reach a Python-level hook (androidMain/README.md, step 2) -- and it runs once
 * per interpreter, so there is nothing to gain from a promotion anyway. The caller holds the GIL.
 */
static jint upcall_publish(JNIEnv *e, jclass c, jlong ns) {
    if (ns == 0) return 0;
    if (g_upcallBridge == NULL) return 0;
    if (!pmp_install_method(ns, &g_pmResolveDef)) return 0;
    if (!pmp_install_method(ns, &g_pmInvokeFreeDef)) return 0;
    if (!pmp_install_method(ns, &g_pmBindDef)) return 0;
    if (!pmp_install_method(ns, &g_pmReleaseDef)) return 0;
    if (!pmp_install_method(ns, &g_pmCancelDef)) return 0;
    return 1;
}

int CustomJNI_OnLoad(JavaVM *vm, void *reserved) {
    JNIEnv *env;
    if ((*vm)->GetEnv(vm, (void **)&env, JNI_VERSION_1_6) != JNI_OK) {
        return JNI_ERR;
    }
    jclass clazz = (*env)->FindClass(env, "python/native/ffi/bindings");
    if (clazz == NULL) return JNI_ERR;

    g_vm = vm;

    /*
     * Registered before anything can attach, so no thread can ever be attached without a
     * destructor to release it. A failure here is not fatal: pmp_attach falls back to detaching on
     * the way out of each call, which is what this file did unconditionally before.
     */
    g_detachKeyReady = (pthread_key_create(&g_detachKey, pmp_thread_exit_detach) == 0);

    jclass upcallClazz = (*env)->FindClass(env, "python/native/ffi/UpcallTarget");
    if (upcallClazz != NULL) {
        g_upcallClass = (jclass)(*env)->NewGlobalRef(env, upcallClazz);
        g_upcallPrimitive = (*env)->GetStaticMethodID(env, g_upcallClass, "upcallPrimitive", "(J)J");
        g_upcallString = (*env)->GetStaticMethodID(env, g_upcallClass, "upcallString", "(Ljava/lang/String;)J");
        g_upcallTrack = (*env)->GetStaticMethodID(env, g_upcallClass, "trackCurrentThread", "()J");
    }

    /*
     * The Kotlin half of tp_traverse/tp_clear. A global ref, because the slots are called from
     * whichever thread the collector runs on, long after this frame is gone.
     *
     * Every failure here is cleared rather than propagated: FindClass and GetStaticMethodID both
     * leave a pending exception on failure, and RegisterNatives below must not run with one set.
     * A missing class leaves the slots as no-ops, which surfaces as an uncollected cycle rather
     * than as a crash -- and, unlike an abort during library load, leaves the rest of the
     * bindings usable.
     */
    jclass proxyClazz = (*env)->FindClass(env, "python/multiplatform/ffi/ProxyCallbacks");
    if (proxyClazz != NULL) {
        g_proxyCallbacks = (jclass)(*env)->NewGlobalRef(env, proxyClazz);
        g_proxyTraverse = (*env)->GetStaticMethodID(env, g_proxyCallbacks, "traverse", "(J)[J");
        g_proxyClear = (*env)->GetStaticMethodID(env, g_proxyCallbacks, "clear", "(J)V");
        (*env)->DeleteLocalRef(env, proxyClazz);
    }

    /*
     * The Kotlin half of the upcall entry points. A global ref for the same reason: they are
     * called from whichever thread Python happens to be running on, long after this frame is gone.
     *
     * Failures are cleared rather than propagated, as above. A missing class leaves upcall_publish
     * returning 0 -- "the bootstrap could not be installed" -- rather than aborting the load and
     * taking the rest of the bindings with it.
     */
    jclass upcallBridgeClazz = (*env)->FindClass(env, "python/native/ffi/UpcallCallbacks");
    if (upcallBridgeClazz != NULL) {
        g_upcallBridge = (jclass)(*env)->NewGlobalRef(env, upcallBridgeClazz);
        g_upcallInvokeM = (*env)->GetStaticMethodID(env, g_upcallBridge, "invoke", "(JJ)J");
        g_upcallResolveM =
            (*env)->GetStaticMethodID(env, g_upcallBridge, "resolve", "(Ljava/lang/String;)J");
        g_upcallReleaseM = (*env)->GetStaticMethodID(env, g_upcallBridge, "release", "(J)I");
        g_upcallCancelM = (*env)->GetStaticMethodID(env, g_upcallBridge, "cancel", "(J)I");
        (*env)->DeleteLocalRef(env, upcallBridgeClazz);
    }
    if ((*env)->ExceptionCheck(env)) (*env)->ExceptionClear(env);

    JNINativeMethod methods[] = {
        {"Py_Initialize", "()V", (void *)&Py_Initialize},
        {"Py_IsInitialized", "()I", (void *)&Py_IsInitialized},
        {"Py_Finalize", "()V", (void *)&Py_Finalize},
        {"PyErr_Clear", "()V", (void *)&PyErr_Clear},
        {"PyLong_FromLongLong", "(J)J", (void *)&PyLong_FromLongLong},
        {"PyList_Size", "(J)J", (void *)&PyList_Size},
        {"PyRun_SimpleString", "(J)I", (void *)&PyRun_SimpleString},
        {"Py_GetVersion", "()J", (void *)&Py_GetVersion},
        {"PyImport_ImportModule", "(J)J", (void *)&PyImport_ImportModule},
        {"PyObject_GetAttrString", "(JJ)J", (void *)&PyObject_GetAttrString},
        {"PyErr_Occurred", "()J", (void *)&PyErr_Occurred},
        {"echo0", "(J)J", (void *)&critical_echo0},
        {"echo1", "(J)J", (void *)&critical_echo1},
        {"echo2", "(J)J", (void *)&critical_echo2},
        {"echoNormal", "(J)J", (void *)&normal_echo},
        {"echoFast", "(J)J", (void *)&fast_echo},
        {"PyList_SizeFast", "(J)J", (void *)&pylistsize_fast},
        {"PyList_SizeNormal", "(J)J", (void *)&pylistsize_normal},

        {"Py_InitializeF", "()V", (void *)&f_Py_Initialize},
        {"Py_IsInitializedF", "()I", (void *)&f_Py_IsInitialized},
        {"Py_FinalizeF", "()V", (void *)&f_Py_Finalize},
        {"PyErr_ClearF", "()V", (void *)&f_PyErr_Clear},
        {"PyLong_FromLongLongF", "(J)J", (void *)&f_PyLong_FromLongLong},
        {"PyList_SizeF", "(J)J", (void *)&f_PyList_Size},
        {"PyRun_SimpleStringF", "(J)I", (void *)&f_PyRun_SimpleString},
        {"Py_GetVersionF", "()J", (void *)&f_Py_GetVersion},
        {"PyImport_ImportModuleF", "(J)J", (void *)&f_PyImport_ImportModule},
        {"PyObject_GetAttrStringF", "(JJ)J", (void *)&f_PyObject_GetAttrString},
        {"PyErr_OccurredF", "()J", (void *)&f_PyErr_Occurred},
        {"PyList_GetItemRaw", "(JJ)J", (void *)&PyList_GetItem},
        {"PyList_GetItemRawF", "(JJ)J", (void *)&f_PyList_GetItemRaw},
        {"ffiDirectBufferAddress", "(Ljava/nio/ByteBuffer;)J", (void *)&ffi_direct_addr},
        {"asmExec", "(Ljava/lang/String;)I", (void *)&asm_exec},
        {"asmGetAttr", "(JLjava/lang/String;)J", (void *)&asm_getattr},
        {"asmListToArray", "(J[J)I", (void *)&asm_list_to_array},

        /*
         * Ordinary-JNI registrations, reusing the same wrappers as the @FastNative set --
         * the C signature is identical, only the Kotlin-side annotation differs. These back
         * the functions that must never run under a GC-blocking convention.
         */
        {"Py_InitializeN", "()V", (void *)&f_Py_Initialize},
        {"Py_FinalizeN", "()V", (void *)&f_Py_Finalize},
        {"PyErr_ClearN", "()V", (void *)&f_PyErr_Clear},
        {"PyRun_SimpleStringN", "(J)I", (void *)&f_PyRun_SimpleString},
        {"PyImport_ImportModuleN", "(J)J", (void *)&f_PyImport_ImportModule},
        {"PyImport_ImportN", "(J)J", (void *)&f_PyImport_ImportN},
        {"PyObject_GetAttrStringN", "(JJ)J", (void *)&f_PyObject_GetAttrString},

        {"Py_DecRefN", "(J)V", (void *)&f_Py_DecRefN},
        {"Py_IncRefN", "(J)V", (void *)&f_Py_IncRefN},
        {"Py_NewRefN", "(J)J", (void *)&f_Py_NewRefN},
        {"Py_XNewRefN", "(J)J", (void *)&f_Py_XNewRefN},
        {"PyGILState_EnsureN", "()I", (void *)&f_PyGILState_EnsureN},
        {"PyGILState_ReleaseN", "(I)V", (void *)&f_PyGILState_ReleaseN},
        {"PyGILState_GetThisThreadStateN", "()J", (void *)&f_PyGILState_GetThisThreadStateN},
        {"PyEval_SaveThreadN", "()J", (void *)&f_PyEval_SaveThreadN},
        {"PyEval_RestoreThreadN", "(J)V", (void *)&f_PyEval_RestoreThreadN},
        {"Py_MakePendingCallsN", "()I", (void *)&f_Py_MakePendingCallsN},
        {"PyGC_CollectN", "()J", (void *)&f_PyGC_CollectN},
        {"PyEval_InitThreadsN", "()V", (void *)&f_PyEval_InitThreadsN},
        {"PyThreadState_GetDictN", "()J", (void *)&f_PyThreadState_GetDictN},
        {"PyTuple_NewN", "(J)J", (void *)&f_PyTuple_NewN},
        {"PyTuple_SetItemN", "(JJJ)I", (void *)&f_PyTuple_SetItemN},
        {"PyDict_NewN", "()J", (void *)&f_PyDict_NewN},
        {"PyDict_SetItemStringN", "(JJJ)I", (void *)&f_PyDict_SetItemStringN},
        {"PyDict_SetItemN", "(JJJ)I", (void *)&f_PyDict_SetItemN},
        {"PyDict_GetItemStringN", "(JJ)J", (void *)&f_PyDict_GetItemStringN},


        {"PyUnicode_AsUTF8", "(J)J", (void *)&PyUnicode_AsUTF8},
        {"PyUnicode_AsUTF8F", "(J)J", (void *)&f_PyUnicode_AsUTF8},
        {"PyUnicode_FromString", "(J)J", (void *)&PyUnicode_FromString},
        {"PyUnicode_FromStringF", "(J)J", (void *)&f_PyUnicode_FromString},

        {"PyImport_AddModuleRefN", "(J)J", (void *)&f_PyImport_AddModuleRefN},
        {"PyImport_AddModuleN", "(J)J", (void *)&f_PyImport_AddModuleN},
        {"PySys_GetObjectN", "(J)J", (void *)&f_PySys_GetObjectN},
        {"PyErr_SetStringN", "(JJ)V", (void *)&f_PyErr_SetStringN},
        {"PyObject_SetAttrStringN", "(JJJ)I", (void *)&f_PyObject_SetAttrStringN},
        {"PyObject_DelAttrStringN", "(JJ)I", (void *)&f_PyObject_DelAttrStringN},
        {"PyRun_StringN", "(JIJJ)J", (void *)&f_PyRun_StringN},
        {"PyObject_StrN", "(J)J", (void *)&f_PyObject_StrN},
        {"PyObject_IsTrueN", "(J)I", (void *)&f_PyObject_IsTrueN},
        {"PyObject_CallNoArgsN", "(J)J", (void *)&f_PyObject_CallNoArgsN},
        {"PyObject_CallObjectN", "(JJ)J", (void *)&f_PyObject_CallObjectN},
        {"PyErr_PrintN", "()V", (void *)&f_PyErr_PrintN},
        {"PyErr_GetRaisedExceptionN", "()J", (void *)&f_PyErr_GetRaisedExceptionN},
        {"PyErr_SetRaisedExceptionN", "(J)V", (void *)&f_PyErr_SetRaisedExceptionN},
        {"PyException_GetTracebackN", "(J)J", (void *)&f_PyException_GetTracebackN},
        {"PyException_GetContextN", "(J)J", (void *)&f_PyException_GetContextN},
        {"PyException_GetCauseN", "(J)J", (void *)&f_PyException_GetCauseN},
        {"PyObject_TypeN", "(J)J", (void *)&f_PyObject_TypeN},
        {"PyObject_IsInstanceN", "(JJ)I", (void *)&f_PyObject_IsInstanceN},
        {"PyObject_ReprN", "(J)J", (void *)&f_PyObject_ReprN},
        {"PyObject_RichCompareN", "(JJI)J", (void *)&f_PyObject_RichCompareN},
        {"PyObject_RichCompareBoolN", "(JJI)I", (void *)&f_PyObject_RichCompareBoolN},
        {"PyObject_GetIterN", "(J)J", (void *)&f_PyObject_GetIterN},
        {"PyObject_GetItemN", "(JJ)J", (void *)&f_PyObject_GetItemN},
        {"PyObject_SetItemN", "(JJJ)I", (void *)&f_PyObject_SetItemN},
        {"PyObject_DelItemN", "(JJ)I", (void *)&f_PyObject_DelItemN},
        {"PyObject_CallN", "(JJJ)J", (void *)&f_PyObject_CallN},
        {"PyType_GetNameN", "(J)J", (void *)&f_PyType_GetNameN},
        {"PyType_IsSubtypeN", "(JJ)I", (void *)&f_PyType_IsSubtypeN},
        {"PyModule_GetDictN", "(J)J", (void *)&f_PyModule_GetDictN},
        {"PyModule_GetFilenameObjectN", "(J)J", (void *)&f_PyModule_GetFilenameObjectN},
        {"PyModule_GetNameN", "(J)J", (void *)&f_PyModule_GetNameN},
        {"PyDict_ClearN", "(J)V", (void *)&f_PyDict_ClearN},
        {"PyDict_ContainsN", "(JJ)I", (void *)&f_PyDict_ContainsN},
        {"PyDict_DelItemN", "(JJ)I", (void *)&f_PyDict_DelItemN},
        {"PyDict_GetItemN", "(JJ)J", (void *)&f_PyDict_GetItemN},
        {"PyDict_ItemsN", "(J)J", (void *)&f_PyDict_ItemsN},
        {"PyDict_SizeN", "(J)J", (void *)&f_PyDict_SizeN},
        {"PyDict_ValuesN", "(J)J", (void *)&f_PyDict_ValuesN},
        {"PyList_AppendN", "(JJ)I", (void *)&f_PyList_AppendN},
        {"PyList_AsTupleN", "(J)J", (void *)&f_PyList_AsTupleN},
        {"PyList_InsertN", "(JJJ)I", (void *)&f_PyList_InsertN},
        {"PyList_ReverseN", "(J)I", (void *)&f_PyList_ReverseN},
        {"PyList_SortN", "(J)I", (void *)&f_PyList_SortN},
