/* int PyWeakref_GetRef(PyObject *ref, PyObject **pobj) -- replaces PyWeakref_GetObject,
   which 3.15 removed. PyObject* travels as jlong here like every other pointer in this
   file; the out-parameter takes void** so the pointer is never punned through an integer
   pointer. Both android ABIs this builds for (arm64-v8a, x86_64) are 64-bit. */
extern jint PyWeakref_GetRef(jlong ref, void **pobj);
