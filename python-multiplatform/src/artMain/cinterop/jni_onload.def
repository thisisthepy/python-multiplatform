/*
 * The rest of the CPython surface `bindings.kt` declares.
 *
 * Everything below used to be reached by name-based `@CName` linking against the exports in
 * `nativeMain/.../EmbedAPI.native.kt`, which declare no `JNIEnv*`/`jclass` prologue -- so the
 * arguments arrived shifted by two registers. That does not fail cleanly: it corrupts a pointer
 * and kills the process (ROADMAP §2, `PyImport_AddModule` at fault address 0xc24110e8).
 *
 * The Kotlin declarations were also `JNIPointer?`, i.e. a boxed `java.lang.Long`, which cannot be
 * registered against a C function taking `jlong` at all. They are raw `Long` now, so every
 * descriptor below is primitive-only.
 *
 * Ordinary JNI throughout, per §3's default. Nothing here is on a measured hot path, and a large
 * share of it can execute arbitrary Python (a `__del__` reached by dropping the last reference, a
 * `__eq__` during a dict merge, a descriptor during a generic attribute access), which a
 * GC-blocking convention must not do.
 */
extern void Py_InitializeEx(jint initsigs);
extern jint Py_IsFinalizing(void);
extern jint Py_FinalizeEx(void);
extern jlong PyEval_EvalCode(jlong co, jlong globals, jlong locals);
